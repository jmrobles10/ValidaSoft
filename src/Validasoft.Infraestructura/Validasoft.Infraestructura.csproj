<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="JasperFx.Events" />
    <PackageReference Include="Marten" />
    <PackageReference Include="WolverineFx.Http" />
    <PackageReference Include="WolverineFx.Marten" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="MailKit" />
    <!-- Passkeys (WebAuthn) del ingreso sin contraseñas (ING-2). -->
    <PackageReference Include="Fido2" />
    <PackageReference Include="AWSSDK.S3" />
    <!-- QR de la URL de verificación en el PDF del certificado (CE-6). -->
    <PackageReference Include="QRCoder" />
