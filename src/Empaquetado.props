<Project>
  <!--
    Metadatos y versión de los paquetes NuGet del SDK: Validasoft.Contratos y Validasoft.Sdk (docs/08 §2.4).
    La versión es la de todo el SDK —la misma de @validasoft/sdk en npm— y se cambia con `node infra/sdk/version.mjs <versión>`, que
    también actualiza packages/sdk/package.json; el workflow sdk-publicar.yml exige que el tag sdk-v<versión> coincida con las dos.
    Cada proyecto aporta su README.md; el CHANGELOG y la licencia son los del SDK.
  -->
  <PropertyGroup>
    <VersionSdk>1.0.0</VersionSdk>
    <Version>$(VersionSdk)</Version>
    <Authors>Validasoft</Authors>
    <Company>Validasoft</Company>
    <Copyright>Copyright (c) 2026 Validasoft</Copyright>
    <PackageProjectUrl>https://github.com/jmrobles10/ValidaSoft/tree/main/src/Validasoft.Sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jmrobles10/ValidaSoft</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENCIA-SDK.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Ver CHANGELOG.md dentro del paquete.</PackageReleaseNotes>
    <!-- Depuración desde el consumidor: el código fuente se enlaza con Source Link (incluido en el SDK de .NET) y los símbolos van en un .snupkg. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)Validasoft.Sdk\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\LICENCIA-SDK.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
